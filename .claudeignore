# PlatformIO build artifacts
.pio/
build/

# Compiled binaries
*.bin
*.elf
*.hex
*.map

# IDE and editor config
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Secrets (should never be read)
.env
.env.*
*.pem
*.key

# Large data
*.sqlite
*.db

# Course archive (large reference material, read on demand)
course-archive/github-repo/

# Generated test output (ephemeral, not useful in context)
tools/test-renderers-output.svg

# Hub sync state (machine-managed, not useful in context)
.ccanvil/ccanvil.lock

# Hub local config (read via scripts, not raw file reads)
.claude/ccanvil.local.json
